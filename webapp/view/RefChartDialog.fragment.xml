<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog
    id="dialogRefChart"
    title="Refrence Chart"
    draggable="true"
    resizable="true">
    <VBox id="_IDGenVBox">
        <Image id="IDLikelihoodTable" width="90%" height="40%" src="{viewModel>/images/likelihoodTable}" class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiTinyMarginBottom" />
        <Image id="IDSeverityTable" width="90%" height="40%" src="{viewModel>/images/severityTable}" class="sapUiSmallMarginBegin sapUiSmallMarginTop" />
    </VBox>
    <buttons>
      <Button id="_IDGenButton1" text="Close" press="onCloseRefChart" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
