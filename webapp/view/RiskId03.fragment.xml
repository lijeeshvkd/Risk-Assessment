<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog
    id="JHARiskVHDlg"
    title="Select Items"
    draggable="true"
    resizable="true"
    afterClose="onDialogAfterClose03" >

    <VBox>
      <CheckBox text="Select All" select="onJHARiskSelectAll" />
      <SearchField id="JHARiskVHSearch" liveChange="onSearch03" placeholder="Search..." />
      <List id="JHARiskVHList" mode="MultiSelect" growing="true"
        items="{
          path: '/ZEHS_I_RISK_ID',
          filters: [
            { path: 'type', operator: 'EQ', value1: 'JHA' }
          ]
        }"
        selectionChange="onSelectionChange03" >
        <StandardListItem title="{id} - {title}" />
      </List>
    </VBox>

    <buttons>
      <Button text="Cancel" press="onRiskCancel03" />
      <Button text="OK" press="onJHARiskConfirm" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
